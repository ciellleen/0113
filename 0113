# 4. 숫자1, 숫자2 두 개의 숫자를 입력 받아 포인터 두 개의 인자를 받는 함수로 두 숫자를 바꾼 후 출력해주는 프로그램을 만드세요.(숫자1을 출력하면 숫자2의 숫자가 나오고, 숫자2를 출력하면 숫자1이 나오게 하세요. 함수에서 두 값을 서로 바꿈)

```c
#define _CRT_SECURE_NO_WARNINGS 
#include<stdio.h> 

void ChangeNumbers(int* p1, int* p2) 
{
    int temp = *p1; // p1이 가리키는 값을 임시 저장
    *p1 = *p2;      // p1에 p2의 값을 저장
    *p2 = temp;     // p2에 임시 저장된 값을 저장
}

int main(void) 
{ 
    int num1, num2; 

    printf("숫자1 : "); 
    scanf("%d", &num1); 
    printf("숫자2 : "); 
    scanf("%d", &num2);

    ChangeNumbers(&num1, &num2); // 두 숫자의 주소를 전달

    printf("바뀐 숫자1 : %d\n", num1); 
    printf("바뀐 숫자2 : %d\n", num2);

    return 0;
}

```

