# 3. 숫자를 입력 받아 해당 숫자를 제곱으로 바꿔주는 함수를 만드세요. (반환 형태가 void이고, 포인터 사용)

```c
#define _CRT_SECURE_NO_WARNINGS 
#include <stdio.h> 

void ChangeSquare(int* p) 
{
    *p = (*p) * (*p); // 포인터가 가리키는 값을 제곱으로 변경
}

int main() 
{ 
    int num; 
    printf("숫자를 입력하시오 : "); 
    scanf("%d", &num);

    ChangeSquare(&num); // num의 주소를 전달
    printf("숫자의 제곱 값은 : %d\n", num); 

    return 0;
}

```

