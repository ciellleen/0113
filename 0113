# 2. 숫자를 입력 받아 해당 숫자를 가리키는 포인터를 만들어 해당 숫자의 값과 포인터의 값을 출력하고, 두 주소도 출력하여 같은 값이 나오는지 확인해보세요.

```c
#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h> 

int main() 
{ 
    int num; 
    int* numP; // 포인터 선언

    printf("숫자를 입력하시오 : "); 
    scanf("%d", &num); 

    numP = &num; // num의 주소를 numP에 저장

    printf("숫자의 값: %d\n", num); 
    printf("포인터의 값: %d\n", *numP); 
    printf("숫자의 주소: %p\n", &num); 
    printf("포인터의 주소: %p\n", numP); 

    return 0;
}

```

