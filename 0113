# 1. int형 변수를 선언하여 사용자에게 입력 받은 후 해당 값을 2배로 바꿔주는 함수(반환 형태 : void)를 사용하여 입력 받은 수의 2배를 출력하시오

```c
#define _CRT_SECURE_NO_WARNINGS 
#include <stdio.h> 

void ChangeDouble(int* p)
{
    *p *= 2;
}

int main()
{
    int num;
    printf("숫자를 입력하시오 : ");
    scanf("%d", &num);

    ChangeDouble(&num);
    printf("입력된 수의 2배는 : %d\n", num);

    return 0;
}

```

